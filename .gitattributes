# Default: text files normalized to LF in repo, checkout uses LF
*                 text=auto eol=lf

# Windows scripts use CRLF on checkout
*.ps1             text eol=crlf
*.cmd             text eol=crlf
*.bat             text eol=crlf

# Unix-y scripts & code stay LF
*.sh              text eol=lf
*.ts              text eol=lf
*.tsx             text eol=lf
*.js              text eol=lf
*.jsx             text eol=lf
*.json            text eol=lf
*.yml             text eol=lf
*.yaml            text eol=lf
*.md              text eol=lf
Dockerfile        text eol=lf

# Treat common binaries as binary (no EOL conversion)
*.png             binary
*.jpg             binary
*.jpeg            binary
*.gif             binary
*.ico             binary
*.pdf             binary
*.zip             binary
*.gz              binary
*.br              binary
*.wasm            binary
